# NoorPost Ultimate Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or credentials to version control.

# =============================================================================
# 1. DROPBOX (Recommended for cloud storage & Make.com Instagram automation)
# =============================================================================
# Create an app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
DROPBOX_FOLDER=/NoorPost

# =============================================================================
# 2. YOUTUBE SHORTS (Optional)
# =============================================================================
# Download OAuth 2.0 client secrets JSON from Google Cloud Console
# and save it as credentials.json in the project root
YT_CREDENTIALS_FILE=credentials.json
YT_TOKEN_FILE=yt_token.pkl
SKIP_YOUTUBE=True

# =============================================================================
# 3. DIRECT INSTAGRAM GRAPH API (Optional)
# =============================================================================
# Only needed if you are posting directly via Meta Graph API without Make.com
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# =============================================================================
# 4. SUNNAH.COM OFFICIAL API (Optional — see SUNNAH_API_REQUEST.md)
# =============================================================================
# Request API key at https://github.com/sunnah-com/api/issues
# If omitted, system safely falls back to local verified canonical Hadiths
SUNNAH_API_KEY=

# =============================================================================
# 5. SCHEDULER & AUTOMATION
# =============================================================================
TIMEZONE=Asia/Kolkata
POST_TIMES=08:00,13:00,17:00,21:00

# Set to True to generate videos and preview images without publishing
REQUIRE_APPROVAL=False
PREVIEW_ONLY=False

# =============================================================================
# 6. VIDEO RENDER SETTINGS
# =============================================================================
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_DURATION=15
VIDEO_FPS=24
THEME_MODE=dark-gold
FONT_MODE=amiri
